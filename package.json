{
  "name": "vaycho",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n FRONTEND,BACKEND -c cyan,magenta \"npm run dev:local --prefix frontend\" \"npm run dev:local --prefix backend\"",
    "dev:frontend": "npm run dev:local --prefix frontend",
    "dev:backend": "npm run dev:local --prefix backend",
    "build": "npm run build --prefix frontend && npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "test:worker": "vitest run --config vitest.config.ts",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "deploy": "npm run build:frontend && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "concurrently": "^9.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.54.0"
  }
}
